# Octopussy: FABERGÉ — Special-Agent Mission Software (reference config)
# Reference copy of every configurable field for new BOND film packages.
# Copy to config.yaml and edit; strict mode fails on undefined tokens.

paper:
  title: "Octopussy: FABERGÉ — Special-Agent Mission Software"
  subtitle: "Spectral/UV Forgery Detection, Circus-Cover Logistics, and Concealed-Device Sweep"
  version: "0.1.0"
  date: "2026-08-04"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

publication:
  github_repository: "docxology/bond-octopussy"
  journal: "BOND Mission Software Series"
  year: "2026"

keywords:
  - "artifact forgery detection"
  - "spectral fingerprinting"
  - "min-cost flow"
  - "radiation anomaly detection"
  - "concealed device detection"

metadata:
  license: "MIT"
  language: "en"

render:
  formats:
    pdf: true
    html: true
    slides: true
    docx: true
    epub: true

testing:
  max_test_failures: 0
  max_project_test_failures: 0
